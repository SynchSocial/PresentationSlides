# Firecrawl API key — get one at https://www.firecrawl.dev (Dashboard > API Keys).
# Leave blank to run in MOCK mode (deterministic fake prices, no network).
FIRECRAWL_API_KEY=

# Force mock even if a key is present (1 = on)
MOCK=

# API port
PORT=8787

# Daily scrape schedule (cron syntax, server local time). Default 9am.
CRON=0 9 * * *
