# Firecrawl API key — get one at https://www.firecrawl.dev (Dashboard > API Keys).
# Leave blank to run in MOCK mode (deterministic fake prices, no network).
FIRECRAWL_API_KEY=

# Force mock even if a key is present (1 = on)
MOCK=

# Keepa API key (https://keepa.com/#!api -> "Private API access keys").
# When set, the Amazon price source uses Keepa instead of scraping Amazon search.
# Leave blank to keep Amazon on the Firecrawl mock/scrape path.
KEEPA_API_KEY=
# Keepa marketplace domain id (1 = amazon.com, 2 = .co.uk, 3 = .de, ...).
KEEPA_DOMAIN=1
# Listing auto-vetting: a pinned Amazon listing must come from a seller at least
# this reputable (skipped when sold by Amazon). % positive feedback + # ratings.
KEEPA_MIN_SELLER_RATING=90
KEEPA_MIN_SELLER_COUNT=50

# eBay Browse API (developer.ebay.com -> your app keyset). Client-credentials
# OAuth; when both are set, eBay is added as an auto-vetted price source.
# Leave blank to keep eBay off (mock).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US
# sandbox (test keys) or production. Token mint limit: 1,000/day — the app token
# is cached and reused until expiry, so a daily scrape uses ~1.
EBAY_ENV=production
# An eBay listing must come from a seller at least this reputable.
EBAY_MIN_FEEDBACK_PCT=95
EBAY_MIN_FEEDBACK_SCORE=50

# API port
PORT=8787

# Daily scrape schedule (cron syntax, server local time). Default 9am.
CRON=0 9 * * *

# Discovery sweep — finds + auto-publishes newly released handhelds.
# Default weekly, Mondays 10am.
CRON_DISCOVER=0 10 * * 1
